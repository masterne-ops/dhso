[Unit]
Description=SO 数据分析 Streamlit App
Documentation=https://github.com/jinlei/so-data-analytics
After=network-online.target docker.service
Wants=network-online.target
# V3 Code Agent 沙箱依赖 docker daemon
# 没装 Docker 也不会让 streamlit 跑不起来（V3 page 自己会展示"未就绪"）
# 但 docker 有装的话保证它在 streamlit 之前就绪
After=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/so-data-analytics/src
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/so-data-analytics/venv/bin:/usr/local/bin:/usr/bin:/bin"

# Streamlit 启动参数
# - 0.0.0.0:8501 公网直访（阿里云安全组放行 8501）
# - headless 不开浏览器
# - XSRF 保护开（CSRF 防护）
# - 禁用使用统计
ExecStart=/opt/so-data-analytics/venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableXsrfProtection=true \
    --browser.gatherUsageStats=false \
    --server.maxUploadSize=100

# 自启 + 失败自重启
Restart=always
RestartSec=5
StartLimitIntervalSec=180
StartLimitBurst=5

# 日志（跟 logrotate 配合，copytruncate 模式）
StandardOutput=append:/opt/so-data-analytics/logs/streamlit.log
StandardError=append:/opt/so-data-analytics/logs/streamlit.err

# 内存保护：服务器 3.4G RAM
# 重点：不设 MemoryHigh（软限）—— 它会持续 throttle，让用户体验变慢
# 只设 MemoryMax 硬上限 3G（留 400M 给 OS 和其他服务），到顶就 kill 重启
# Swap 给 1G 缓冲，避免突发请求直接被杀
MemoryMax=3G
MemorySwapMax=1G

# 优先 kill 本服务而不是系统进程（OOM 时）
OOMScoreAdjust=300

# OOMPolicy：超内存就 kill（systemd 自动 Restart=always 接住）
OOMPolicy=kill

# 文件描述符上限（Streamlit + DataFrame cache 可能开很多）
LimitNOFILE=65536

# 优雅停止超时
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
